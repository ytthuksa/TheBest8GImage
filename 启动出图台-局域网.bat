@echo off
chcp 936 >nul
title Qwen-Image-2.1 出图台 - 启动（局域网模式）
setlocal
rem 监听 0.0.0.0：同一 WiFi 下的手机 / 平板也能打开
set "WEB_HOST=0.0.0.0"
echo ============================================================
echo    Qwen-Image-2.1 出图台 —— 局域网模式
echo ============================================================
echo.
echo   [注意] 服务监听 0.0.0.0，同一局域网内任何人都能打开，没有密码。
echo          公共 WiFi（咖啡厅 / 酒店 / 公司访客网）下不要用这个脚本。
echo.
call "%~dp0启动出图台.bat"
exit /b 0
